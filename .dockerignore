# Keep the build context small: only Go source + the committed bundle are needed.
.git
.github
.toolchains
dist
docs
provider
build/js/node_modules
**/*_test.go
*.md
# The image is a distribution, so the notices travel with it (LICENSE has no
# extension and was never excluded).
!THIRD-PARTY-NOTICES.md
compose*.yaml
Dockerfile
.dockerignore
# Never copy local env/secret files into the build context.
.env
*.env
.env.*
