# Node deps for rebuilding the browser bundle (`make deps`)
build/js/node_modules/

# Cross-compiled release binaries (`make release`)
/dist/

# Local scratch
*.tmp
*.patch

# internal/browser/bg_browser_bundle.js is a committed build output. Do not
# ignore it.

# Built CLI binary at the repo root. Anchored so it does not also match the
# cmd/waxseal source directory.
/waxseal

# Local compose inputs: the .env compose reads for WAXSEAL_VERSION, and the
# tenant-keys file docs/deployment.md mounts as a secret. Neither is anchored:
# a copy of the compose file can live in any directory of a checkout.
.env
tenant-keys
